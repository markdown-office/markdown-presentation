# Dependencies, installed by Composer. The lock file is not committed either: it is
# a library, and a committed lock file pins the development dependencies of a
# checkout rather than anything a consumer gets. `composer audit` needs one, so the
# audit job resolves before it audits.
/vendor/
/composer.lock

# The patches the plugin applied, in the same way: it pins this checkout rather than
# anything a consumer gets.
/patches.lock.json

# The analyser, fetched by checksum into here by tools/install-phpstan.php. The
# version and the hash live in that script and in the job that runs it, so nothing
# but a downloaded binary is ever ignored by accident.
/tools/phpstan.phar
/tools/slidev-parity/node_modules/
/tools/slidev-parity/package-lock.json
/tools/slidev-parity/core.ts
/tools/slidev-parity/core.runnable.ts

# Everything the build produces.

# Scratch space for the tests, emptied after every run.
/tmp/

# Test runner state.
/.phpunit.cache/
/.phpunit.result.cache

# The OOXML schemas `tools/install-ooxml-schemas.php` fetches and checksums.
/tools/ooxml-schemas/

# The fonts `tools/generate-font-metrics.php` fetches and checksums.
/tools/fonts/

# A local override; the committed configuration is phpunit.xml.dist.
/phpunit.xml

# Coverage reports, if written next to the project rather than into build/.
/coverage/
/coverage.xml
/clover.xml

# Where tools/render-with-powerpoint.applescript is told to write the PDFs it exports
# from PowerPoint. Ignored rather than left out of the repository's own list of build
# output, because a PDF of somebody's deck is not something a library should ever
# have to carry.

# Editors and operating systems.
.DS_Store
.idea/
.vscode/
*.swp
*~
# Everything the examples build produces.
/examples/out/

# PDFs exported by PowerPoint, wherever a caller asked for them to land inside this
# checkout. A PDF of a deck is a rendering of somebody's content and has no place in
# a library's history.
/build/
/powerpoint/

# Parallel agent worktrees
.worktrees/
