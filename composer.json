{
    "name": "markdown-office/markdown-presentation",
    "description": "The PowerPoint half of markdown-office: a Slidev-compatible deck splitter and a strict theme resolver for Markdown slide decks.",
    "type": "library",
    "keywords": [
        "markdown",
        "pptx",
        "powerpoint",
        "slides",
        "deck",
        "slidev",
        "theme",
        "yaml",
        "frontmatter"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Graßl",
            "email": "mail@fabiangrassl.de"
        }
    ],
    "require": {
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "league/commonmark": "^2.10",
        "markdown-office/commonmark-generic-directives": "^0.2.0",
        "phpoffice/phppresentation": "dev-fix/picture-bytes#7302812113bf8ef75d0f77fdc5bb57e82c3d853f",
        "php": "^8.2",
        "symfony/yaml": "^7.2 || ^8.0"
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/markdown-office/PHPPresentation"
        }
    ],
    "require-dev": {
        "ext-simplexml": "*",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0"
    },
    "suggest": {
        "ext-imagick": "Embeds SVG. PowerPoint holds a vector only beside a raster of it, so something has to draw the raster; without this an SVG raises rather than going in as a picture no reader can show."
    },
    "autoload": {
        "psr-4": {
            "MarkdownPresentation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkdownPresentation\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=unit",
        "test:readme": "pest --testsuite=readme",
        "test:coverage": "pest --coverage --min=100",
        "analyse": "tools/phpstan.sh",
        "check": [
            "@composer validate --strict",
            "@analyse",
            "@test"
        ]
    }
}
