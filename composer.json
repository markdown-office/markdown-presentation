{
    "name": "markdown-office/markdown-presentation",
    "description": "The PowerPoint half of markdown-office: a Slidev-compatible deck splitter and a strict theme resolver for Markdown slide decks.",
    "type": "library",
    "keywords": [
        "markdown",
        "pptx",
        "powerpoint",
        "slides",
        "deck",
        "slidev",
        "theme",
        "yaml",
        "frontmatter"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Fabian Graßl",
            "email": "mail@fabiangrassl.de"
        }
    ],
    "require": {
        "cweagans/composer-patches": "^2.0",
        "ext-dom": "*",
        "ext-gd": "*",
        "ext-zip": "*",
        "league/commonmark": "^2.10",
        "markdown-office/commonmark-generic-directives": "^0.2.0",
        "phpoffice/phppresentation": "~1.2.0",
        "php": "^8.2",
        "symfony/yaml": "^7.2 || ^8.0"
    },
    "require-dev": {
        "ext-simplexml": "*",
        "pestphp/pest": "^3.0 || ^4.0 || ^5.0"
    },
    "extra": {
        "patches": {
            "phpoffice/phppresentation": [
                {
                    "description": "PHPPresentation 1.2.0 brought up to upstream's master, with the fix that gives a picture the path, the bytes and the name it was read from",
                    "url": "https://raw.githubusercontent.com/markdown-office/PHPPresentation/474af4fc8815e88f231cd73ac09cdcfcb28c12c8/patches/phpoffice-phppresentation-1.2.0-to-master.patch",
                    "sha256": "326d82477614aeac1e2f7fa357687422568550cb2b4a3aec3a29611f120de81a"
                }
            ]
        }
    },
    "suggest": {
        "ext-imagick": "Embeds SVG. PowerPoint holds a vector only beside a raster of it, so something has to draw the raster; without this an SVG raises rather than going in as a picture no reader can show."
    },
    "autoload": {
        "psr-4": {
            "MarkdownPresentation\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarkdownPresentation\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "cweagans/composer-patches": true,
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=unit",
        "test:readme": "pest --testsuite=readme",
        "test:coverage": "php -d memory_limit=-1 vendor/bin/pest --coverage --min=100",
        "analyse": "tools/phpstan.sh",
        "check": [
            "@composer validate --strict",
            "@analyse",
            "@test"
        ]
    }
}
